{
  "name": "tabscore-webapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test --project=chromium",
    "test:visual": "playwright test --project=visual-1024x768 --project=visual-1280x768 --project=visual-1440x900 --project=visual-1920x1080",
    "test:visual:update": "playwright test --project=visual-1024x768 --project=visual-1280x768 --project=visual-1440x900 --project=visual-1920x1080 --update-snapshots",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "test:audio": "playwright test --project=audio",
    "test:perf": "playwright test --project=perf"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "immer": "^10.1.1",
    "midi-file": "^1.2.4",
    "opentype.js": "^1.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tonejs/midi": "^2.0.28",
    "@types/node": "^22.10.2",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^31.0.1",
    "terser": "^5.49.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "24.x"
  }
}
